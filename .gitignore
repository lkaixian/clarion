# =========================================================================
# CLARION Root Git Ignore
# Covers Python backend, React Native / Expo, Flutter, Vite Web, and OS / IDEs
# =========================================================================

# Dependencies & Build Outputs
node_modules/
dist/
dist-ssr/
build/
.build/
*.egg-info/
.eggs/

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.db
*.sqlite
*.sqlite3
clarion.db

# Expo & React Native
.expo/
.expo-shared/
web-build/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/mobile_flutter/build/
/mobile_flutter/android/app/debug
/mobile_flutter/android/app/profile
/mobile_flutter/android/app/release

# Environment variables & secrets
.env
.env.*
!.env.example
!.env.docker.example
!.env.tunnel.example

# TLS material for the edge proxy (P1.9) -- never commit real keys/certs
proxy/certs/*
!proxy/certs/.gitkeep
proxy/branch-edge/certs/*
!proxy/branch-edge/certs/.gitkeep
proxy/caddy_data/

# Alertmanager SMTP secret (P5.1) -- never commit a real password
observability/secrets/*
!observability/secrets/.gitkeep

# MariaDB data-at-rest encryption key material (P2.7) -- generated per
# deployment by backend/db/mariadb/generate-encryption-key.sh. Losing these
# = unrecoverable data; back them up SEPARATELY from the DB.
backend/db/mariadb/encryption/*
!backend/db/mariadb/encryption/README.md

# Android release signing secrets (P1.13) -- never commit the real keystore
# or its passwords. See mobile_flutter/android/key.properties.example.
/mobile_flutter/android/key.properties
/mobile_flutter/android/*.jks
/mobile_flutter/android/*.keystore
proxy/caddy_config/

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Local Claude Code workspace (per-machine commands / worktrees / settings) --
# not shared. The .claude/worktrees/ gitlink that is already tracked stays as
# it is; this only stops new local .claude/ contents being committed.
.claude/

# Scratch / working notes, not part of the deliverable
gemin-text.txt

# Obsidian / Claudian editor state for the healthcare/ knowledge vault -- the
# .md notes ARE tracked, but the per-machine workspace layout, app settings,
# and bundled plugin binaries (a ~5MB main.js) are not.
healthcare/.obsidian/
healthcare/.claudian/

# Design source files -- large binaries, keep them out of app history
# (use external storage / git-lfs if they must be versioned).
*.psd

# P5.2: raw locust CSV output from a load-test run -- regenerate on demand
# (backend/loadtest/README.md documents how); summarised results live in
# that README, not as committed per-run CSVs.
backend/loadtest/results/

# Local, per-machine Compose overrides (e.g. publishing backend's port
# directly for a load test -- see docs/deployment.md / backend/loadtest/
# README.md). Compose auto-loads this file; never meant to be shared.
docker-compose.override.yml

# Operator-only recovery material -- never commit
.local-secrets/

# Built APK is published by copying it here (see docs/deployment.md "Mobile app download"); never commit binaries
web/public/downloads/*.apk
web/public/downloads/*.sha256
