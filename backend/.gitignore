# Python / FastAPI Backend Git Ignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite database files
*.db
*.sqlite
*.sqlite3
medibridge.db

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs & Cache
*.log
.pytest_cache/
.coverage
htmlcov/

# Original files uploaded via POST /ai/digitise/{patient_id}, persisted to
# disk so GET /patients/{id}/documents/{id}/file can serve them back. Real
# (potentially sensitive) patient documents -- never committed.
uploads/

# Pre-migration SQLite backups (see main.py's _backup_sqlite_file_before_migration)
backups/
