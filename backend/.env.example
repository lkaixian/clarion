# CLARION backend environment variables.
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# ---- Auth secrets (REQUIRED -- the app fails to start without these) ----
# SECRET_KEY signs/verifies every JWT this API issues (see app/auth.py).
# OTP_HMAC_KEY is the keyed-HMAC secret used to hash password-reset OTP
# codes at rest (never store the plaintext code -- see auth.hash_otp_code).
# Both MUST be real, high-entropy, secret values -- there is deliberately
# no hardcoded fallback. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value for each (don't reuse SECRET_KEY as OTP_HMAC_KEY).
# Rotating either value invalidates every currently-issued JWT / any
# in-flight OTP -- expected and correct, forces re-login / a fresh OTP
# request everywhere.
SECRET_KEY=
OTP_HMAC_KEY=

# ---- CORS ----
# Resolution order:
#   1. CORS_ALLOWED_ORIGINS set -> exactly that comma-separated allowlist,
#      e.g. CORS_ALLOWED_ORIGINS=https://clarion.example.edu.my
#   2. else APP_ENV=demo (or DEMO_MODE in demo/1/true) -> allow_origins=["*"]
#      -- EXPLICIT opt-in to wide-open CORS for local dev / judging.
#   3. else -> allow_origins=[] : FAIL CLOSED. A cross-origin browser SPA is
#      blocked until you set one of the above.
# The shipped value here is APP_ENV=demo so a fresh `.env` works for local
# dev. Change to APP_ENV=production (and set CORS_ALLOWED_ORIGINS) for any
# real deployment. A same-origin setup (nginx /api proxy) needs none of this.
CORS_ALLOWED_ORIGINS=
APP_ENV=demo
# DEMO_MODE is a legacy alias for APP_ENV. Prefer APP_ENV; leave this blank.
DEMO_MODE=

# ---- Reverse-proxy trust ----
# FORWARDED_ALLOW_IPS: which upstream hop(s) gunicorn trusts for
# X-Forwarded-For / X-Forwarded-Proto. The per-IP rate limiter keys on the
# resulting client IP, so a too-wide value lets a caller forge it. Read
# natively by gunicorn; default 127.0.0.1. Set to your edge proxy's
# address/subnet in deployment. NEVER "*".
FORWARDED_ALLOW_IPS=

# ---- Mailgun (password-reset OTP emails) ----
# Find these in the Mailgun dashboard: https://app.mailgun.com/
#   - API key: Settings -> API Keys -> "Private API key"
#   - Domain:  Sending -> Domains (use your verified sending domain, e.g.
#              mg.yourdomain.com, or Mailgun's sandbox domain for testing)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Optional. Defaults to "CLARION <noreply@{MAILGUN_DOMAIN}>" if unset.
MAILGUN_SENDER_EMAIL=CLARION <noreply@YOURDOMAIN.com>

# Optional. Defaults to the US region. Only set this if your Mailgun
# account is provisioned in the EU region (Mailgun dashboard tells you
# which region you're on) -- use https://api.eu.mailgun.net/v3 in that case.
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3

# If MAILGUN_API_KEY or MAILGUN_DOMAIN is left unset, the backend still
# runs fine -- password-reset-OTP requests are accepted normally, the code
# is generated and stored server-side, but no email is actually sent
# (logged server-side as "Mailgun not configured"). Useful for local dev
# without real Mailgun credentials.

# ---- Cloud AI opt-in (LEAVE UNSET -- see app/ai/_cloud_guard.py) ----
# The AI features (handover summary, NRIC OCR) can call the Anthropic API,
# but that sends patient data / MyKad images off-machine, which breaks
# the tender and the PDPA. Those calls are DISABLED BY DEFAULT.
# Every feature falls back to its deterministic / local path (which is what
# runs for the demo). Only a developer deliberately testing the cloud path
# sets BOTH of these; NEVER set them in a campus/production deployment.
#   CLARION_ALLOW_CLOUD_AI=1
#   ANTHROPIC_API_KEY=<key>
CLARION_ALLOW_CLOUD_AI=

# ---- Database (MariaDB cutover P1.3) ----
# Defaults to sqlite:///./clarion.db if unset.
# To connect to MariaDB, use:
# DATABASE_URL=mysql+pymysql://clarion_app:change-me-app-password@localhost:3306/clarion?charset=utf8mb4
# (Replace localhost with your actual DB host if running outside Compose)
DATABASE_URL=

# ---- Object storage (P1.6 -- app/storage.py) ----
# Every binary blob (clinical-document originals, staff signatures, medicine
# photos, OCR scratch) goes through an ObjectStore.
#   CLARION_STORAGE_BACKEND=local  -> a plain directory tree; the default.
#     Root defaults to backend/object_store/ ; override with CLARION_STORAGE_ROOT.
#   CLARION_STORAGE_BACKEND=minio  -> an S3-API MinIO server (the on-prem
#     target). Requires MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
CLARION_STORAGE_BACKEND=
CLARION_STORAGE_ROOT=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_SECURE defaults to 1 (TLS). Set 0 only for a plain-HTTP dev MinIO.
MINIO_SECURE=
MINIO_REGION=

# ---- LDAP / Active Directory (P1.10 -- app/ldap_auth.py) ----
# A SECOND, opt-in auth provider next to local accounts (which always keep
# working -- break-glass admin, service integrations, patient logins never
# go through LDAP). LEAVE LDAP_ENABLED UNSET for local dev / the demo.
#
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldap://dc.campus.local:389        # or ldaps://... for LDAPS
# LDAP_USE_SSL=false                              # true if LDAP_SERVER_URI is ldaps://
# LDAP_START_TLS=false                            # STARTTLS on a plain ldap:// connection
# LDAP_BIND_DN=cn=clarion-svc,ou=service,dc=campus,dc=local
# LDAP_BIND_PASSWORD=change-me-service-account-password
# LDAP_BASE_DN=ou=people,dc=campus,dc=local
# LDAP_USER_SEARCH_FILTER=(mail={username})       # {username} is escaped before substitution
# LDAP_ATTR_EMAIL=mail
# LDAP_ATTR_FULL_NAME=displayName
# LDAP_ATTR_MEMBEROF=memberOf
# LDAP_CONNECT_TIMEOUT_SECONDS=5
#
# TLS is NOT optional for a real deployment (voltagent security review M3):
# with both flags below unset, ldap_auth REFUSES to bind at all rather than
# silently sending passwords in cleartext -- LDAP_ALLOW_INSECURE_BIND=true
# is the explicit, loud override for a lab/demo directory only.
# LDAP_USE_SSL=true                               # ldaps://
# LDAP_START_TLS=true                             # STARTTLS on ldap://  (pick one of these two, or neither for a deliberately insecure lab setup)
# LDAP_CA_CERT_FILE=/path/to/campus-ca.pem           # unset = OS default trust store; set this to pin a private/AD-CS CA
# LDAP_ALLOW_INSECURE_BIND=false                   # true = explicitly accept plaintext LDAP -- never in production
#
# LDAP_MAX_CONCURRENT_BINDS=8                      # process-wide cap on in-flight LDAP binds (DoS guard -- an
#                                                   # unauthenticated request that doesn't match any local account
#                                                   # still triggers a real, slow directory round trip)
LDAP_ENABLED=
LDAP_SERVER_URI=
LDAP_USE_SSL=
LDAP_START_TLS=
LDAP_CA_CERT_FILE=
LDAP_ALLOW_INSECURE_BIND=
LDAP_MAX_CONCURRENT_BINDS=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_SEARCH_FILTER=
LDAP_ATTR_EMAIL=
LDAP_ATTR_FULL_NAME=
LDAP_ATTR_MEMBEROF=
LDAP_CONNECT_TIMEOUT_SECONDS=

# After enabling LDAP, map at least one AD group to a CLARION role via
# POST /admin/ldap-role-mappings (admin-only) before anyone can actually log
# in through it -- a directory bind that succeeds but matches no group is
# DENIED, not given a default role (least privilege). "patient" and
# "emergency_responder" are not assignable roles here -- LDAP is a
# staff-identity provider only.
