# MediBridge backend environment variables.
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# ---- Auth secrets (REQUIRED -- the app fails to start without these) ----
# SECRET_KEY signs/verifies every JWT this API issues (see app/auth.py).
# OTP_HMAC_KEY is the keyed-HMAC secret used to hash password-reset OTP
# codes at rest (never store the plaintext code -- see auth.hash_otp_code).
# Both MUST be real, high-entropy, secret values -- there is deliberately
# no hardcoded fallback. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value for each (don't reuse SECRET_KEY as OTP_HMAC_KEY).
# Rotating either value invalidates every currently-issued JWT / any
# in-flight OTP -- expected and correct, forces re-login / a fresh OTP
# request everywhere.
SECRET_KEY=
OTP_HMAC_KEY=

# ---- CORS (tighten before any real deployment) ----
# CORS_ALLOWED_ORIGINS: comma-separated list of real origins allowed to
# call this API from a browser, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://staff.example.com
# Left unset, CORS defaults to allow_origins=["*"] (wide open) whenever
# APP_ENV/DEMO_MODE is unset or explicitly "demo" -- the "just works for
# judging" convenience this project has always had. Before deploying this
# somewhere reachable on the open internet with real patient data: set
# CORS_ALLOWED_ORIGINS to your actual origins AND set APP_ENV to something
# other than "demo" (e.g. APP_ENV=production), so a forgotten/blank
# CORS_ALLOWED_ORIGINS fails safe to "no origins allowed" instead of
# silently staying wide open.
CORS_ALLOWED_ORIGINS=
APP_ENV=

# ---- Mailgun (password-reset OTP emails) ----
# Find these in the Mailgun dashboard: https://app.mailgun.com/
#   - API key: Settings -> API Keys -> "Private API key"
#   - Domain:  Sending -> Domains (use your verified sending domain, e.g.
#              mg.yourdomain.com, or Mailgun's sandbox domain for testing)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Optional. Defaults to "MediBridge <noreply@{MAILGUN_DOMAIN}>" if unset.
MAILGUN_SENDER_EMAIL=MediBridge <noreply@YOURDOMAIN.com>

# Optional. Defaults to the US region. Only set this if your Mailgun
# account is provisioned in the EU region (Mailgun dashboard tells you
# which region you're on) -- use https://api.eu.mailgun.net/v3 in that case.
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3

# If MAILGUN_API_KEY or MAILGUN_DOMAIN is left unset, the backend still
# runs fine -- password-reset-OTP requests are accepted normally, the code
# is generated and stored server-side, but no email is actually sent
# (logged server-side as "Mailgun not configured"). Useful for local dev
# without real Mailgun credentials.
