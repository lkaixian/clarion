# CLARION backend environment variables.
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# ---- Auth secrets (REQUIRED -- the app fails to start without these) ----
# SECRET_KEY signs/verifies every JWT this API issues (see app/auth.py).
# OTP_HMAC_KEY is the keyed-HMAC secret used to hash password-reset OTP
# codes at rest (auth.hash_otp_code) AND registered NFC card UIDs at rest
# (auth.hash_nfc_uid, Security Audit M7). Migration f3a9d21c5e88 needs it
# set to rewrite any existing emergency_tokens rows -- it hard-fails
# otherwise rather than bricking every physical card with an empty key.
# Both MUST be real, high-entropy, secret values -- there is deliberately
# no hardcoded fallback. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value for each (don't reuse SECRET_KEY as OTP_HMAC_KEY).
# Rotating either value invalidates every currently-issued JWT / any
# in-flight OTP -- expected and correct, forces re-login / a fresh OTP
# request everywhere.
SECRET_KEY=
OTP_HMAC_KEY=

# ---- CORS ----
# Resolution order:
#   1. CORS_ALLOWED_ORIGINS set -> exactly that comma-separated allowlist,
#      e.g. CORS_ALLOWED_ORIGINS=https://clarion.example.edu.my
#   2. else APP_ENV=demo (or DEMO_MODE in demo/1/true) -> allow_origins=["*"]
#      -- EXPLICIT opt-in to wide-open CORS for local dev / judging.
#   3. else -> allow_origins=[] : FAIL CLOSED. A cross-origin browser SPA is
#      blocked until you set one of the above.
# The shipped value here is APP_ENV=demo so a fresh `.env` works for local
# dev. Change to APP_ENV=production (and set CORS_ALLOWED_ORIGINS) for any
# real deployment. A same-origin setup (nginx /api proxy) needs none of this.
CORS_ALLOWED_ORIGINS=
APP_ENV=demo
# DEMO_MODE is a legacy alias for APP_ENV. Prefer APP_ENV; leave this blank.
DEMO_MODE=

# ---- Refresh-token cookie ----
# REFRESH_COOKIE_PATH: Path attribute on the HttpOnly refresh-token cookie.
# Default "/" and you almost never need to change it: the browser matches
# Path against the REQUEST URL, and the documented same-origin setup calls
# `/api/auth/refresh` (the proxy strips `/api` before the backend). A value
# like "/auth" would never be sent on that path -> silent refresh dies and
# the session drops to a full re-login every 15 min. Narrow to "/auth" ONLY
# if the browser hits the backend origin directly with no /api prefix.
REFRESH_COOKIE_PATH=

# ---- Reverse-proxy trust ----
# FORWARDED_ALLOW_IPS: which upstream hop(s) gunicorn trusts for
# X-Forwarded-For / X-Forwarded-Proto. The per-IP rate limiter keys on the
# resulting client IP, so a too-wide value lets a caller forge it. Read
# natively by gunicorn; default 127.0.0.1. Set to your edge proxy's
# address/subnet in deployment. NEVER "*".
FORWARDED_ALLOW_IPS=

# ---- Mailtrap (password-reset / self-registration OTP emails) ----
# Mailtrap dashboard: https://mailtrap.io/
#   Real delivery  -> Email API / Sending Domains: verify your domain, then
#                     Settings -> API Tokens, create a token with send access.
#   Sandbox (demo) -> Email Testing -> your inbox. Nothing is delivered; the
#                     message lands in the Mailtrap inbox. Set MAILTRAP_INBOX_ID.
MAILTRAP_API_TOKEN=

# Optional. Sender address; it must be on a domain verified in Mailtrap for
# real delivery. Defaults to noreply@clarion.larmkx.com.
MAILTRAP_SENDER_EMAIL=noreply@clarion.larmkx.com

# Optional. Set to use the Email Testing sandbox instead of real delivery.
MAILTRAP_INBOX_ID=

# If MAILTRAP_API_TOKEN is left unset, the backend still runs fine --
# password-reset-OTP requests are accepted normally, the code is generated
# and stored server-side, but no email is actually sent (logged server-side
# as "Mailtrap not configured"). Useful for local dev without credentials.

# ---- On-prem AI engine (P4.3, see app/ai/local_llm.py) ----
# The AI features (handover summary, NRIC OCR) talk to a local Ollama server
# -- nothing leaves the machine, so this is safe to leave at its defaults.
# `ollama pull llama3.2` and `ollama pull llava` once on the host; if Ollama
# isn't running, every feature falls back to its deterministic/Tesseract
# path automatically (fine for local dev without a GPU).
# CLARION_LOCAL_LLM_URL=http://localhost:11434
# Ollama can also run on a separate host on the same private LAN (e.g. a
# dedicated GPU box) instead of this machine -- point the URL above at that
# host's :11434 instead (e.g. http://192.168.1.50:11434); any loopback/
# private/link-local address is accepted (see docs/deployment.md's "Running
# Ollama on a separate GPU host" note).
# CLARION_LOCAL_LLM_MODEL=llama3.2
# CLARION_LOCAL_VISION_MODEL=llava
# CLARION_LOCAL_LLM_TIMEOUT=30
# Set to force every AI feature straight to its fallback (e.g. no GPU on stage):
CLARION_DISABLE_LOCAL_AI=

# ---- PACS / DICOM imaging (P4.7, see app/pacs.py) ----
# X-ray studies are stored in the on-prem Orthanc service (docker-compose.yml)
# -- refused unless it resolves to loopback/private/link-local, same guard
# class as CLARION_LOCAL_LLM_URL above. Default matches the compose service
# name; only change this for local dev against a standalone Orthanc.
# CLARION_ORTHANC_URL=http://orthanc:8042
# CLARION_ORTHANC_TIMEOUT=30
# Basic auth -- must match docker-compose.yml's orthanc service
# ORTHANC__REGISTERED_USERS (ORTHANC_HTTP_USER/PASSWORD in .env.docker).
# Unset means an unauthenticated Orthanc, which local dev without compose
# (a bare `orthanc` binary with default config) still is.
# CLARION_ORTHANC_USER=clarion
# CLARION_ORTHANC_PASSWORD=change-me-orthanc-http

# ---- Lab-analyser HL7 v2 integration (P4.8, see app/hl7_client.py + app/hl7_listener.py) ----
# Outbound order push -- a real analyser's own MLLP port. Unset disables
# the push (order creation always succeeds regardless).
# CLARION_HL7_ANALYSER_HOST=
# CLARION_HL7_ANALYSER_PORT=2575
# CLARION_HL7_ANALYSER_TIMEOUT=5

# ---- Database (MariaDB cutover P1.3) ----
# Defaults to sqlite:///./clarion.db if unset.
# To connect to MariaDB, use:
# DATABASE_URL=mysql+pymysql://clarion_app:change-me-app-password@localhost:3306/clarion?charset=utf8mb4
# (Replace localhost with your actual DB host if running outside Compose)
DATABASE_URL=

# ---- Object storage (P1.6 -- app/storage.py) ----
# Every binary blob (clinical-document originals, staff signatures, medicine
# photos, OCR scratch) goes through an ObjectStore.
#   CLARION_STORAGE_BACKEND=local  -> a plain directory tree; the default.
#     Root defaults to backend/object_store/ ; override with CLARION_STORAGE_ROOT.
#   CLARION_STORAGE_BACKEND=minio  -> an S3-API MinIO server (the on-prem
#     target). Requires MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
CLARION_STORAGE_BACKEND=
CLARION_STORAGE_ROOT=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_SECURE defaults to 1 (TLS). Set 0 only for a plain-HTTP dev MinIO.
MINIO_SECURE=
MINIO_REGION=

# ---- LDAP / Active Directory (P1.10 -- app/ldap_auth.py) ----
# A SECOND, opt-in auth provider next to local accounts (which always keep
# working -- break-glass admin, service integrations, patient logins never
# go through LDAP). LEAVE LDAP_ENABLED UNSET for local dev / the demo.
#
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldap://dc.campus.local:389        # or ldaps://... for LDAPS
# LDAP_USE_SSL=false                              # true if LDAP_SERVER_URI is ldaps://
# LDAP_START_TLS=false                            # STARTTLS on a plain ldap:// connection
# LDAP_BIND_DN=cn=clarion-svc,ou=service,dc=campus,dc=local
# LDAP_BIND_PASSWORD=change-me-service-account-password
# LDAP_BASE_DN=ou=people,dc=campus,dc=local
# LDAP_USER_SEARCH_FILTER=(mail={username})       # {username} is escaped before substitution
# LDAP_ATTR_EMAIL=mail
# LDAP_ATTR_FULL_NAME=displayName
# LDAP_ATTR_MEMBEROF=memberOf
# LDAP_CONNECT_TIMEOUT_SECONDS=5
#
# TLS is NOT optional for a real deployment (voltagent security review M3):
# with both flags below unset, ldap_auth REFUSES to bind at all rather than
# silently sending passwords in cleartext -- LDAP_ALLOW_INSECURE_BIND=true
# is the explicit, loud override for a lab/demo directory only.
# LDAP_USE_SSL=true                               # ldaps://
# LDAP_START_TLS=true                             # STARTTLS on ldap://  (pick one of these two, or neither for a deliberately insecure lab setup)
# LDAP_CA_CERT_FILE=/path/to/campus-ca.pem           # unset = OS default trust store; set this to pin a private/AD-CS CA
# LDAP_ALLOW_INSECURE_BIND=false                   # true = explicitly accept plaintext LDAP -- never in production
#
# LDAP_MAX_CONCURRENT_BINDS=8                      # process-wide cap on in-flight LDAP binds (DoS guard -- an
#                                                   # unauthenticated request that doesn't match any local account
#                                                   # still triggers a real, slow directory round trip)
LDAP_ENABLED=
LDAP_SERVER_URI=
LDAP_USE_SSL=
LDAP_START_TLS=
LDAP_CA_CERT_FILE=
LDAP_ALLOW_INSECURE_BIND=
LDAP_MAX_CONCURRENT_BINDS=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_SEARCH_FILTER=
LDAP_ATTR_EMAIL=
LDAP_ATTR_FULL_NAME=
LDAP_ATTR_MEMBEROF=
LDAP_CONNECT_TIMEOUT_SECONDS=

# After enabling LDAP, map at least one AD group to a CLARION role via
# POST /admin/ldap-role-mappings (admin-only) before anyone can actually log
# in through it -- a directory bind that succeeds but matches no group is
# DENIED, not given a default role (least privilege). "patient" and
# "emergency_responder" are not assignable roles here -- LDAP is a
# staff-identity provider only.

# ---- Data-quality monitoring (P2.12 -- app/data_quality.py) ----
# Comma-separated rule keys to skip on a `db.data_quality_scan` run
# (`python -m db.data_quality_scan --list-rules` prints them all). A disabled
# rule's existing alerts are left as-is, not auto-resolved. Empty = run all.
DATA_QUALITY_DISABLED_RULES=

# ---- University SMP/SMS/e-klinik-panel/Registrar eligibility check ----
# MOCK stand-in -- see app/campus_registry.py's module docstring. Unset = the
# in-process demo mock (app/routers/campus_registry_mock.py). Point this at a
# real endpoint once one exists; no code change needed.
CAMPUS_REGISTRY_BASE_URL=
