# CLARION -- docker compose environment.
#
#   cp .env.docker.example .env.docker
#   # then fill in the REQUIRED values below
#
# .env.docker holds real secrets -- add it to .gitignore and never commit it.
# docker-compose.yml loads it via `env_file` (into containers) and you should
# also pass it for interpolation:
#
#   docker compose --env-file .env.docker up -d --build
#   docker compose --env-file .env.docker config

# ===========================================================================
# Application
# ===========================================================================

# demo | production. "demo" is an EXPLICIT opt-in to wide-open CORS
# (allow_origins=["*"]) for judging. Anything else (or unset) fails CLOSED:
# no cross-origin browser calls unless CORS_ALLOWED_ORIGINS is set. Set to
# "production" for any reachable deployment.
APP_ENV=demo

# --- REQUIRED: auth secrets. The backend refuses to start without these. ---
# Generate each SEPARATELY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
OTP_HMAC_KEY=

# Comma-separated browser origins allowed to call the API directly. With the
# edge proxy the SPA is same-origin (API_BASE=/api) so this stays blank.
# Only needed if you point the SPA at a cross-origin API host.
#   e.g. CORS_ALLOWED_ORIGINS=https://clarion.example.edu.my
CORS_ALLOWED_ORIGINS=

# Upstream hop gunicorn trusts for X-Forwarded-For/-Proto (the rate limiter
# keys on client IP). This MUST be the edge proxy's fixed compose address
# and nothing wider -- NEVER "*". Change it only if you also change the
# proxy's ipv4_address / the network subnet in docker-compose.yml.
FORWARDED_ALLOW_IPS=172.28.0.2

# ===========================================================================
# Edge proxy (Caddy) -- the only service that publishes to the host
# ===========================================================================
# Host ports for the proxy. 80 redirects to 443.
HTTP_PORT=80
HTTPS_PORT=443

# FQDN clients use. "localhost" for the demo. For a real deployment set the
# actual hostname AND switch CLARION_TLS_DIRECTIVE to the file form below.
CLARION_SITE_ADDRESS=localhost

# Demo: "tls internal" (Caddy's own local CA; run `docker compose exec proxy
# caddy trust` to silence the browser warning). Production: put the
# CAMPUS-CA-issued PEM pair in proxy/certs/ and set:
#   CLARION_TLS_DIRECTIVE=tls /etc/caddy/certs/clarion.crt /etc/caddy/certs/clarion.key
CLARION_TLS_DIRECTIVE=tls internal

# Extra CSP connect-src entries (space-separated). Reception kiosks running
# the USB NFC bridge need its origin here:
#   CLARION_CSP_CONNECT_EXTRA=http://localhost:8770 http://127.0.0.1:8770
# NOTE: do NOT copy demo values like http://localhost:8000 into a real
# deployment's CSP -- behind the proxy the SPA is same-origin.
CLARION_CSP_CONNECT_EXTRA=

# HSTS header value. Demo ships a short pin so a machine isn't locked into
# HTTPS-only for long. Ramp deliberately for production, e.g.
#   CLARION_HSTS=max-age=31536000; includeSubDomains
# Add "; preload" ONLY with the University domain-owner sign-off on the exact FQDN
# (never the apex) -- it is near-irreversible.
CLARION_HSTS=max-age=300

# Where the browser sends API calls. Keep "/api" -- the edge proxy routes
# /api/* to the backend on the same origin (no CORS). A full URL here only
# makes sense if you deliberately bypass the proxy for the API.
API_BASE=/api

# ===========================================================================
# Database
# ===========================================================================
# database.py supports both SQLite and MariaDB. The 4-slash form is an absolute
# path inside the container; it maps to the clarion_db named volume mounted at /app/data.
DATABASE_URL=sqlite:////app/data/clarion.db

# --- MariaDB 11.4 (P1.3 cutover complete; ready for data migration P1.4) ---
# The init script creates three least-privilege accounts automatically.
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=clarion
MARIADB_APP_PASSWORD=change-me-app-password
MARIADB_MIGRATE_PASSWORD=change-me-migrate-password
MARIADB_REPORT_PASSWORD=change-me-report-password
# When cutting over to MariaDB, use:
# DATABASE_URL=mysql+pymysql://clarion_app:change-me-app-password@mariadb:3306/clarion?charset=utf8mb4
#
# P2.7 encryption at rest: before the first `up` of the mariadb service, run
#   bash backend/db/mariadb/generate-encryption-key.sh
# It writes backend/db/mariadb/encryption/keyfile (git-ignored). Compose
# mounts it read-only; encryption.cnf turns on InnoDB/Aria/log/binlog/tmp
# encryption. Back the keyfile up SEPARATELY from the DB. Details:
# docs/deployment.md "Encryption at rest".

# --- Backup / DR (P2.8 -- backend/backup/, `docker compose --profile backup`) ---
# Required for the backup service. RESTIC_REPOSITORY points at VM-BACKUP
# (sftp:/rest:/s3: ...). AGE recipients add a second encryption layer on the
# DB dump files themselves (for the offline-disk copy). See
# backend/backup/README.md for the full DR runbook + restore procedure.
RESTIC_REPOSITORY=sftp:backup@vm-backup:/srv/restic/clarion
RESTIC_PASSWORD=change-me-restic-repo-password
BACKUP_AGE_RECIPIENTS=
BACKUP_KEEP_DAILY=30

# ===========================================================================
# Object store -- MinIO (S3 API)
# ===========================================================================
MINIO_ROOT_USER=clarion
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
# Scoped per-service MinIO accounts (minio-init / backend/db/minio/10-accounts.sh)
# -- backend/orthanc/backup each get their own user+password instead of the
# root creds above, which after provisioning are only needed by minio-init
# itself and by an operator using the MinIO console/`mc admin`.
MINIO_BACKEND_PASSWORD=change-me-minio-backend
MINIO_ORTHANC_PASSWORD=change-me-minio-orthanc
MINIO_BACKUP_PASSWORD=change-me-minio-backup

# ===========================================================================
# Cache -- Redis
# ===========================================================================
REDIS_URL=redis://redis:6379/0

# ===========================================================================
# PACS -- Orthanc + its PostgreSQL index (roadmap task P4.7)
# ===========================================================================
ORTHANC_PG_USER=orthanc
ORTHANC_PG_PASSWORD=change-me-orthanc-db
ORTHANC_PG_DB=orthanc
# HTTP basic auth -- Orthanc's ORTHANC__REGISTERED_USERS and the backend's
# CLARION_ORTHANC_USER/PASSWORD both read these, so they always match.
# No " or \ in either value -- docker-compose.yml interpolates them straight
# into a JSON literal with no escaping.
ORTHANC_HTTP_USER=clarion
ORTHANC_HTTP_PASSWORD=change-me-orthanc-http

# ===========================================================================
# Lab-analyser HL7 v2 integration (roadmap task P4.8)
# ===========================================================================
# Outbound order push -- point this at a REAL analyser's own MLLP port once
# one exists. Unset (the default) disables the push entirely; order
# creation always succeeds either way, see app/hl7_client.py.
# CLARION_HL7_ANALYSER_HOST=
# CLARION_HL7_ANALYSER_PORT=2575

# ===========================================================================
# Mailgun -- password-reset OTP email (optional; blank = OTP generated but
# no email actually sent)
# ===========================================================================
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER_EMAIL=CLARION <noreply@YOURDOMAIN.com>
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3

# ===========================================================================
# On-prem AI engine (P4.3, see backend/app/ai/local_llm.py) -- talks to a
# local Ollama server, nothing leaves the machine. Defaults assume Ollama
# runs on the host with `llama3.2` and `llava` pulled; override if it runs
# elsewhere (e.g. a container/service name) or under different model names.
# If unreachable, every AI feature falls back to its deterministic/Tesseract
# path automatically.
# ===========================================================================
CLARION_LOCAL_LLM_URL=http://localhost:11434
CLARION_LOCAL_LLM_MODEL=llama3.2
CLARION_LOCAL_VISION_MODEL=llava
CLARION_DISABLE_LOCAL_AI=
