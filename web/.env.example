# CLARION web console -- build/dev environment variables.
# Copy to `.env` (or `.env.local`, git-ignored) and adjust for local dev.
# NOTE: in a container these do NOT apply -- the API base is injected at
# runtime by entrypoint.sh from $API_BASE (see docker-compose.yml, README).
#
# SECURITY: any `VITE_`-prefixed var referenced in web/src/** is substituted
# verbatim into the shipped client bundle (public). Never give a secret a
# `VITE_` prefix. (VITE_DEV_API_PROXY below is only read in vite.config.js at
# dev-server start -- Vite drops server config from `vite build` -- so it
# never reaches a production bundle.)

# ---- Backend API base ----
# Where the SPA sends API calls. Resolution order at runtime:
#   1. window.__CLARION_API_BASE__  (/config.js, set from $API_BASE in prod)
#   2. VITE_API_BASE                (this file -- build/dev override)
#   3. http://localhost:8000        (default)
# Leave unset for the common local-dev case (backend on :8000, CORS wide
# open in demo mode). Set to "/api" to exercise the same-origin proxy path
# that production uses (the dev server proxies /api -> VITE_DEV_API_PROXY).
VITE_API_BASE=

# Where `npm run dev` forwards /api/* requests. Only used when VITE_API_BASE
# is "/api". Defaults to http://localhost:8000.
VITE_DEV_API_PROXY=

# ---- NFC bridge (Reception page, physical emergency cards) ----
# The local desktop helper that talks to a USB NFC reader. This is a
# workstation-local service by design -- localhost is correct for a normal
# deployment; override only if the bridge runs on another port/host.
VITE_NFC_BRIDGE_URL=http://localhost:8770
